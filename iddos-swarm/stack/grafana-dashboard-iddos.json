{
  "uid": "iddos-main",
  "title": "IDDoS — Health-Check Restart Storm",
  "tags": ["iddos", "swarm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Web task UP (restart storm shows as red gaps)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 30, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "up{job=\"iddos-web\"}", "legendFormat": "web up" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Web restarts (dashboard range)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 3 }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "changes(process_start_time_seconds{job=\"iddos-web\"}[$__range])", "legendFormat": "restarts" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "/work request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } }
      },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "rate(iddos_work_requests_total[1m])", "legendFormat": "/work" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Health-check results (pass vs fail, per second)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "fail" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "pass" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "rate(iddos_health_checks_total{result=\"pass\"}[1m])", "legendFormat": "pass" },
        { "refId": "B", "expr": "rate(iddos_health_checks_total{result=\"fail\"}[1m])", "legendFormat": "fail" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB probe latency p95 (seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } }
      },
      "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(iddos_db_probe_seconds_bucket[1m])) by (le))", "legendFormat": "p95 db probe" }
      ]
    }
  ]
}
